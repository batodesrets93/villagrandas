generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMIN
  PROPIETARIO
}

enum Torre {
  GRANDE
  CHICA
}

enum Turno {
  MEDIODIA
  NOCHE
}

enum EstadoReserva {
  CONFIRMADA
  CANCELADA
}

enum EstadoReclamo {
  ABIERTO
  RESPONDIDO
  CERRADO
}

enum EstadoPagoInformado {
  PENDIENTE
  CONFIRMADO
  RECHAZADO
}

enum CategoriaReclamo {
  RUIDO
  MANTENIMIENTO
  SEGURIDAD
  CONVIVENCIA
  ASCENSOR
  PLOMERIA
  ELECTRICIDAD
  LIMPIEZA
  OTRO
}

model Usuario {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  nombre       String
  rol          Rol
  activo       Boolean   @default(true)
  unidadId     String?
  unidad       Unidad?   @relation(fields: [unidadId], references: [id])
  reclamos     Reclamo[]
  reservas     Reserva[]
  createdAt    DateTime  @default(now())
}

model Unidad {
  id                          String   @id @default(cuid())
  torre                       Torre
  piso                        String
  depto                       String
  titular                     String
  ambientes                   String
  m2                          Float
  coeficiente                 Float
  esDesarrollador             Boolean  @default(false)
  // Marca la unica unidad "cuenta consolidada" a la que se le cargan las
  // cocheras y bauleras que no tienen un propietario asignado (hoy, Costa
  // Tranvial). No es un departamento real: m2 = 0 y coeficiente = 0, para
  // que no le sume gasto comun a nadie, solo absorbe cochera/baulera.
  esConsolidadaCocheraBaulera Boolean  @default(false)

  // m2 ponderado especifico para el calculo de gas (hoja "AGUA CALIENTE-ACELF"
  // del excel: columna E+F+G). Es distinto del m2 real de la unidad. La
  // pileta tambien usa este campo (con esEspacioComun = true) para poder
  // entrar al mismo calculo sin ser un departamento real.
  m2GasPonderado Float?
  // Marca la "unidad" ficticia de la pileta (Torre Grande). No tiene
  // titular real: solo entra al calculo de %incidencia de gas y a la
  // lectura de su propio medidor. Su costo de gas no se le factura a
  // nadie directamente, se agrega como una categoria de gasto comun mas.
  esEspacioComun Boolean @default(false)

  usuarios     Usuario[]
  cargos       CargoUnidadPeriodo[]
  reservas     Reserva[]
  reclamos     Reclamo[]
  cocheras     Cochera[]
  bauleras     Baulera[]
  lecturasGas  LecturaGas[]

  @@unique([torre, piso, depto])
}

// Cada cochera es su propia unidad complementaria, con su propio m2 y su
// propio coeficiente sobre el m2 total del edificio (igual que en la
// pestaña "COCHERAS" del excel). unidadId es opcional: si es null, la
// cochera no tiene propietario asignado todavia, y su parte del gasto se
// le carga a la unidad marcada como esConsolidadaCocheraBaulera.
model Cochera {
  id             String  @id @default(cuid())
  planta         String
  numero         String
  ancho          Float
  largo          Float
  m2             Float
  caracteristica String?
  unidadId       String?
  unidad         Unidad? @relation(fields: [unidadId], references: [id])

  cargos CargoCocheraPeriodo[]

  @@unique([planta, numero])
}

// Igual que Cochera, pero para bauleras.
model Baulera {
  id       String  @id @default(cuid())
  planta   String
  numero   String
  ancho    Float
  largo    Float
  m2       Float
  unidadId String?
  unidad   Unidad? @relation(fields: [unidadId], references: [id])

  cargos CargoBauleraPeriodo[]

  @@unique([planta, numero])
}

model PeriodoExpensa {
  id          String    @id @default(cuid())
  etiqueta    String
  fechaInicio DateTime
  fechaFin    DateTime
  vencimiento DateTime
  totalGastos Float     @default(0)
  cerrado     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  // Totales de las dos facturas de gas del periodo (Torre Grande y Torre
  // Chica se facturan por separado). Se usan para el calculo de calefaccion
  // por unidad (ver LecturaGas y calcularGas en calculo.ts).
  facturaGasTorreGrande Float?
  facturaGasTorreChica  Float?

  gastos      GastoCategoria[]
  cargos      CargoUnidadPeriodo[]
  cargosCochera CargoCocheraPeriodo[]
  cargosBaulera CargoBauleraPeriodo[]
  lecturasGas LecturaGas[]
}

// Una lectura de medidor de agua caliente por unidad y por periodo (incluye
// la pileta, marcada con Unidad.esEspacioComun = true). La lectura anterior
// no se guarda aca: se toma de la lecturaActual del periodo anterior de esa
// misma unidad (mismo mecanismo que el arrastre de saldoAnterior).
model LecturaGas {
  id            String         @id @default(cuid())
  periodoId     String
  periodo       PeriodoExpensa @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  unidadId      String
  unidad        Unidad         @relation(fields: [unidadId], references: [id])
  lecturaActual Float
  consumo       Float
  createdAt     DateTime       @default(now())

  @@unique([periodoId, unidadId])
}

model GastoCategoria {
  id             String         @id @default(cuid())
  periodoId      String
  periodo        PeriodoExpensa @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  nombre         String
  monto          Float
  esFondoReserva Boolean        @default(false)
  orden          Int            @default(0)

  comprobantes   Comprobante[]
}

model Comprobante {
  id            String         @id @default(cuid())
  gastoId       String
  gasto         GastoCategoria @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  nombreArchivo String
  tipoArchivo   String
  tamanio       Int
  datos         Bytes
  createdAt     DateTime       @default(now())
}

model CargoUnidadPeriodo {
  id            String         @id @default(cuid())
  periodoId     String
  periodo       PeriodoExpensa @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  unidadId      String
  unidad        Unidad         @relation(fields: [unidadId], references: [id])

  gastoComun    Float
  cochera       Float          @default(0)
  baulera       Float          @default(0)
  quincho       Float          @default(0)
  calefaccion   Float          @default(0)
  // Ajuste manual del admin sobre la liquidacion de esta unidad puntual (no
  // afecta a las demas). Puede ser positivo (ej: se le rompio algo a la
  // unidad y se le cobra) o negativo (ej: descuento por dias proporcionales
  // de un ingreso a mitad de mes, o algo que el consorcio le debe). Se suma
  // directo al total, por eso el signo importa.
  ajuste        Float          @default(0)
  ajusteConcepto String?
  total         Float
  saldoAnterior Float          @default(0)
  totalPagado   Float          @default(0)
  saldoActual   Float

  pagos           Pago[]
  pagosInformados PagoInformado[]
  reservas        Reserva[]

  @@unique([periodoId, unidadId])
}

// Liquidacion individual de cada cochera en un periodo dado (igual criterio
// que la pestaña "COCHERAS" del excel: monto = m2 de esa cochera * (total
// de gastos del periodo / m2 total del edificio)). Queda guardado a que
// unidad se le cobro en ese momento, aunque despues se reasigne la cochera
// a otro propietario.
model CargoCocheraPeriodo {
  id                String         @id @default(cuid())
  periodoId         String
  periodo           PeriodoExpensa @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  cocheraId         String
  cochera           Cochera        @relation(fields: [cocheraId], references: [id])
  unidadCobradaId   String
  monto             Float

  @@unique([periodoId, cocheraId])
}

// Igual que CargoCocheraPeriodo, pero para bauleras.
model CargoBauleraPeriodo {
  id                String         @id @default(cuid())
  periodoId         String
  periodo           PeriodoExpensa @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  bauleraId         String
  baulera           Baulera        @relation(fields: [bauleraId], references: [id])
  unidadCobradaId   String
  monto             Float

  @@unique([periodoId, bauleraId])
}

model Pago {
  id      String             @id @default(cuid())
  cargoId String
  cargo   CargoUnidadPeriodo @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  monto   Float
  fecha   DateTime           @default(now())
  medio   String?
  nota    String?

  pagoInformado PagoInformado?
}

// Pago que el propietario informa desde la app (con comprobante/s), pendiente
// de que el admin lo vea acreditado en la cuenta del edificio y lo confirme.
// Al confirmarlo se crea el Pago real (que sí descuenta el saldoActual del
// propietario) y queda linkeado via pagoId. Si el admin lo rechaza (ej: no
// aparece en la cuenta, monto no coincide), queda marcado como tal con una
// nota, y el saldo del propietario no se toca.
model PagoInformado {
  id        String              @id @default(cuid())
  cargoId   String
  cargo     CargoUnidadPeriodo  @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  monto     Float
  fecha     DateTime
  medio     String?
  nota      String?
  estado    EstadoPagoInformado @default(PENDIENTE)
  notaAdmin String?
  pagoId    String?             @unique
  pago      Pago?               @relation(fields: [pagoId], references: [id])
  createdAt DateTime            @default(now())
  resueltoAt DateTime?

  comprobantes ComprobantePagoInformado[]
}

model ComprobantePagoInformado {
  id              String        @id @default(cuid())
  pagoInformadoId String
  pagoInformado   PagoInformado @relation(fields: [pagoInformadoId], references: [id], onDelete: Cascade)
  nombreArchivo   String
  tipoArchivo     String
  tamanio         Int
  datos           Bytes
  createdAt       DateTime      @default(now())
}

model Quincho {
  id             String    @id @default(cuid())
  nombre         String    @unique
  capacidad      Int
  permitePiscina Boolean   @default(true)
  reservas       Reserva[]
}

model Reserva {
  id            String              @id @default(cuid())
  quinchoId     String
  quincho       Quincho             @relation(fields: [quinchoId], references: [id])
  unidadId      String
  unidad        Unidad              @relation(fields: [unidadId], references: [id])
  usuarioId     String
  usuario       Usuario             @relation(fields: [usuarioId], references: [id])
  fecha         DateTime
  turno         Turno
  estado        EstadoReserva       @default(CONFIRMADA)
  montoAplicado Float               @default(50000)
  cargoId       String?
  cargo         CargoUnidadPeriodo? @relation(fields: [cargoId], references: [id])
  createdAt     DateTime            @default(now())

  @@unique([quinchoId, fecha, turno])
}

model Reclamo {
  id           String        @id @default(cuid())
  unidadId     String
  unidad       Unidad        @relation(fields: [unidadId], references: [id])
  usuarioId    String
  usuario      Usuario       @relation(fields: [usuarioId], references: [id])
  titulo       String
  descripcion  String
  categoria    CategoriaReclamo @default(OTRO)
  estado       EstadoReclamo @default(ABIERTO)
  respuesta    String?
  createdAt    DateTime      @default(now())
  respondidoAt DateTime?
  adjuntos     AdjuntoReclamo[]
}

model AdjuntoReclamo {
  id            String   @id @default(cuid())
  reclamoId     String
  reclamo       Reclamo  @relation(fields: [reclamoId], references: [id], onDelete: Cascade)
  nombreArchivo String
  tipoArchivo   String
  tamanio       Int
  datos         Bytes
  createdAt     DateTime @default(now())
}
