# Cadena de conexion a Postgres (Supabase, Neon, Railway, etc.)
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db"

# Secret para NextAuth. Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="cambiar-esto-por-un-valor-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Credenciales del usuario administrador que crea el seed inicial
ADMIN_EMAIL="admin@villagrandas.com"
ADMIN_PASSWORD="cambiar1234"
