# Cadena de conexion a Postgres, en modo POOLING (importante para Vercel/serverless).
# En Supabase: Project > Connect > Direct connection > "Transaction pooler" (puerto 6543).
DATABASE_URL="postgresql://usuario:password@host:6543/nombre_db?pgbouncer=true"

# Cadena de conexion DIRECTA/SESSION, solo para "prisma db push" y migraciones (puerto 5432 o 5432 del pooler en modo session).
DIRECT_URL="postgresql://usuario:password@host:5432/nombre_db"

# Secret para NextAuth. Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="cambiar-esto-por-un-valor-aleatorio"
NEXTAUTH_URL="http://localhost:3000"

# Credenciales del usuario administrador que crea el seed inicial
ADMIN_EMAIL="admin@villagrandas.com"
ADMIN_PASSWORD="cambiar1234"

# Envío de emails (liquidaciones en PDF a los propietarios).
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu cuenta,
# SMTP_PASS= una "contraseña de aplicación" (no la contraseña normal de la cuenta).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="propiedadesjoaquinrigueiro@gmail.com"
SMTP_PASS="cambiar-por-contraseña-de-aplicación"
SMTP_FROM="Torres Villa Grandas <propiedadesjoaquinrigueiro@gmail.com>"
